<?xml version="1.0" ?>
<robot name="fossbot_educational_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_color" value="Gazebo/Silver" />
  <xacro:property name="blue_color" value="Gazebo/Blue" />
  <xacro:property name="black_color" value="Gazebo/Black" />

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>Revolute 20</left_joint>
      <right_joint>Revolute 21</right_joint>
      <wheel_separation>0.1867</wheel_separation>   <!-- track width -->
      <wheel_radius>0.0353</wheel_radius>

      <topic>/fossbot_sim/cmd_vel</topic>   <!-- fed by fossbot_sim_hw, not /cmd_vel -->
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>Revolute 20</joint_name>
      <joint_name>Revolute 21</joint_name>
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
    <gravity>true</gravity>
  </gazebo>

  <gazebo reference="middle_1">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="left_fender_1">
    <material>${blue_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="right_fender_1">
    <material>${blue_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="wheel_v4__1__1">
    <material>${black_color}</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <!-- <slip1>0.0</slip1>
    <slip2>0.0</slip2> -->
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="wheel_v4_1">
    <material>${black_color}</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <!-- <slip1>0.0</slip1>
    <slip2>0.0</slip2> -->
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="top_1">
    <material>${blue_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="caster">
    <material>${body_color}</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <!-- <slip1>1.0</slip1>
    <slip2>1.0</slip2> -->
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="top_mount">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="lidar_base">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>

<gazebo reference="lidar">
  <material>${black_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="rplidar" type="gpu_lidar">
    <topic>/scan</topic>
    <gz_frame_id>lidar_scan_frame</gz_frame_id>
    <pose>0 0 0 0 0 0</pose>
    <always_on>true</always_on>
    <visualize>false</visualize>
    <update_rate>5.5</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>6.265732</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.15</min>
        <max>12.0</max>
        <resolution>0.0005</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
  </sensor>
</gazebo>

<gazebo reference="camera_link">
  <material>Gazebo/Green</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="raspberry_pi_camera" type="camera">
    <topic>/camera/image</topic>
    <pose>0 0 0 0 0 0</pose>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>
    <camera>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>20.0</far>
      </clip>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.002</stddev>
      </noise>
    </camera>
  </sensor>
</gazebo>

</robot>
