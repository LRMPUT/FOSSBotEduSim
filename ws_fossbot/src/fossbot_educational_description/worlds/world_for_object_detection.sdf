<sdf version='1.10'>
  <world name='default'>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- FLOOR -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WALLS -->
    <model name='walls'>
      <static>true</static>
      <!-- North Wall -->
      <link name='wall_n'>
        <pose>0 2.05 0.25 0 0 0</pose>
        <collision name='c_n'><geometry><box><size>4.2 0.1 0.5</size></box></geometry></collision>
        <visual name='v_n'><geometry><box><size>4.2 0.1 0.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
      <!-- South Wall -->
      <link name='wall_s'>
        <pose>0 -2.05 0.25 0 0 0</pose>
        <collision name='c_s'><geometry><box><size>4.2 0.1 0.5</size></box></geometry></collision>
        <visual name='v_s'><geometry><box><size>4.2 0.1 0.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
      <!-- East Wall -->
      <link name='wall_e'>
        <pose>2.05 0 0.25 0 0 0</pose>
        <collision name='c_e'><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name='v_e'><geometry><box><size>0.1 4.0 0.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
      <!-- West Wall -->
      <link name='wall_w'>
        <pose>-2.05 0 0.25 0 0 0</pose>
        <collision name='c_w'><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name='v_w'><geometry><box><size>0.1 4.0 0.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- OBJECTS -->
    <model name='cactus_green'><static>true</static><pose>1.0 0.0 0.0 0 0 0</pose>
      <link name='link'>
        <visual name='vis'>
            <geometry>
                <mesh><uri>file:///fossbot_ros2/ws_fossbot/install/fossbot_educational_description/share/fossbot_educational_description/worlds/objects/cactus.stl</uri></mesh>
            </geometry>
            <material>
                <ambient>0 1 0 1</ambient>
                <diffuse>0 1 0 1</diffuse>
            </material>
        </visual>
      </link>
    </model>
    
    <model name='cone_orange'><static>true</static><pose>0.0 1.0 0.0 0 0 0</pose>
      <link name='link'>
        <visual name='vis'>
            <geometry>
                <mesh><uri>file:///fossbot_ros2/ws_fossbot/install/fossbot_educational_description/share/fossbot_educational_description/worlds/objects/cone.stl</uri></mesh>
            </geometry>
            <material>
                <ambient>1 0.5 0 1</ambient>
                <diffuse>1 0.5 0 1</diffuse>
            </material>
        </visual>
      </link>
    </model>

    <model name='hydrant_red'><static>true</static><pose>-1.0 0.0 0.0 0 0 0</pose>
      <link name='link'>
        <visual name='vis'>
            <geometry>
                <mesh><uri>file:///fossbot_ros2/ws_fossbot/install/fossbot_educational_description/share/fossbot_educational_description/worlds/objects/hydrant.stl</uri></mesh>
            </geometry>
            <material>
                <ambient>1 0 0 1</ambient>
                <diffuse>1 0 0 1</diffuse>
            </material>
        </visual>
      </link>
    </model>

    <model name='traffic_light_yellow'><static>true</static><pose>0.0 -1.0 0.0 0 0 0</pose>
      <link name='link'>
        <visual name='vis'>
            <geometry>
                <mesh><uri>file:///fossbot_ros2/ws_fossbot/install/fossbot_educational_description/share/fossbot_educational_description/worlds/objects/traffic_light.stl</uri></mesh>
            </geometry>
            <material>
                <ambient>1 1 0 1</ambient>
                <diffuse>1 1 0 1</diffuse>
            </material>
        </visual>
      </link>
    </model>

    <light name='sun' type='directional'>
        <pose>0 0 10 0 0 0</pose>
        <cast_shadows>true</cast_shadows>
        <direction>-0.5 0.5 -1</direction>
        <diffuse>1 1 1 1</diffuse>
    </light>
  </world>
</sdf>