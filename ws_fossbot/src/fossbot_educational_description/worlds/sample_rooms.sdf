        <!-- ================= ROOM 5 ================= -->
        <collision name='r5_right'><pose>13 9 0.25 0 0 0</pose><geometry><box><size>0.2 2.2 0.5</size></box></geometry></collision>
        <visual name='r5_right'><pose>13 9 0.25 0 0 0</pose><geometry><box><size>0.2 2.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

