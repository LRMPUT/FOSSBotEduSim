        <!-- Right Side Indentation Profile (3m, 5m, etc) -->
        <collision name='r2_right_bot'><pose>13 1.5 0.25 0 0 0</pose><geometry><box><size>0.2 3.2 0.5</size></box></geometry></collision>
        <visual name='r2_right_bot'><pose>13 1.5 0.25 0 0 0</pose><geometry><box><size>0.2 3.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r2_indent_h'><pose>11.5 3 0.25 0 0 0</pose><geometry><box><size>3.2 0.2 0.5</size></box></geometry></collision>
        <visual name='r2_indent_h'><pose>11.5 3 0.25 0 0 0</pose><geometry><box><size>3.2 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r2_indent_v'><pose>10 5.5 0.25 0 0 0</pose><geometry><box><size>0.2 5.2 0.5</size></box></geometry></collision>
        <visual name='r2_indent_v'><pose>10 5.5 0.25 0 0 0</pose><geometry><box><size>0.2 5.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r2_top_l'><pose>7.5 8 0.25 0 0 0</pose><geometry><box><size>3.0 0.2 0.5</size></box></geometry></collision>
        <visual name='r2_top_l'><pose>7.5 8 0.25 0 0 0</pose><geometry><box><size>3.0 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r2_top_r'><pose>11.5 8 0.25 0 0 0</pose><geometry><box><size>3.2 0.2 0.5</size></box></geometry></collision>
        <visual name='r2_top_r'><pose>11.5 8 0.25 0 0 0</pose><geometry><box><size>3.2 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <!-- Left wall of Room 2 (Central Divider, 1m Door) -->
        <collision name='r2_left_top'><pose>6 6.5 0.25 0 0 0</pose><geometry><box><size>0.2 3.0 0.5</size></box></geometry></collision>
        <visual name='r2_left_top'><pose>6 6.5 0.25 0 0 0</pose><geometry><box><size>0.2 3.0 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>


        <!-- ================= ROOM 3 ================= -->
        <collision name='r3_left_bot'><pose>0 4.25 0.25 0 0 0</pose><geometry><box><size>0.2 0.5 0.5</size></box></geometry></collision>
        <visual name='r3_left_bot'><pose>0 4.25 0.25 0 0 0</pose><geometry><box><size>0.2 0.5 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r3_left_top'><pose>0 9.5 0.25 0 0 0</pose><geometry><box><size>0.2 3.2 0.5</size></box></geometry></collision>
