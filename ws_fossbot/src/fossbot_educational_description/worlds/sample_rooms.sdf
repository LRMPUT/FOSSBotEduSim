        <visual name='r5_inner_v'><pose>8 9.5 0.25 0 0 0</pose><geometry><box><size>0.2 1.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r5_inner_h'><pose>7 9 0.25 0 0 0</pose><geometry><box><size>2.2 0.2 0.5</size></box></geometry></collision>
        <visual name='r5_inner_h'><pose>7 9 0.25 0 0 0</pose><geometry><box><size>2.2 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

      </link>
    </model>

    <!-- SUN LIGHT -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <linear>1</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>