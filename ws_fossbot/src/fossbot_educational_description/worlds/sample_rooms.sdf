        <collision name='r3_top'><pose>3 11 0.25 0 0 0</pose><geometry><box><size>6.2 0.2 0.5</size></box></geometry></collision>
        <visual name='r3_top'><pose>3 11 0.25 0 0 0</pose><geometry><box><size>6.2 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r3_right'><pose>6 10 0.25 0 0 0</pose><geometry><box><size>0.2 2.2 0.5</size></box></geometry></collision>
        <visual name='r3_right'><pose>6 10 0.25 0 0 0</pose><geometry><box><size>0.2 2.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>


        <!-- ================= CORRIDOR & ROOM 4 ================= -->
        <collision name='corr_top'><pose>-1 8 0.25 0 0 0</pose><geometry><box><size>2.0 0.2 0.5</size></box></geometry></collision>
        <visual name='corr_top'><pose>-1 8 0.25 0 0 0</pose><geometry><box><size>2.0 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='corr_bot'><pose>-1 4.5 0.25 0 0 0</pose><geometry><box><size>2.0 0.2 0.5</size></box></geometry></collision>
        <visual name='corr_bot'><pose>-1 4.5 0.25 0 0 0</pose><geometry><box><size>2.0 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r4_right_top'><pose>-2 9.25 0.25 0 0 0</pose><geometry><box><size>0.2 2.5 0.5</size></box></geometry></collision>
        <visual name='r4_right_top'><pose>-2 9.25 0.25 0 0 0</pose><geometry><box><size>0.2 2.5 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r4_top'><pose>-4 10.5 0.25 0 0 0</pose><geometry><box><size>4.2 0.2 0.5</size></box></geometry></collision>
        <visual name='r4_top'><pose>-4 10.5 0.25 0 0 0</pose><geometry><box><size>4.2 0.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r4_left'><pose>-6 7.5 0.25 0 0 0</pose><geometry><box><size>0.2 6.2 0.5</size></box></geometry></collision>
        <visual name='r4_left'><pose>-6 7.5 0.25 0 0 0</pose><geometry><box><size>0.2 6.2 0.5</size></box></geometry><material><ambient>0.1 0.16 0.42 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material></visual>

        <collision name='r4_bot'><pose>-4 4.5 0.25 0 0 0</pose><geometry><box><size>4.0 0.2 0.5</size></box></geometry></collision>
